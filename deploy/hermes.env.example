# EC2의 /etc/hermes/hermes.env에 root 소유 0600으로 복사해 사용합니다.
# 운영 Hermes 앱 전용 토큰을 서버에서 입력합니다.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_MAPPING_PATH=/etc/hermes/slack_mapping.yaml
# /hermes-draft를 사용할 비공개 채널의 Slack ID를 지정합니다.
SLACK_DRAFT_CHANNEL_ID=
# 합성 데이터 팀 브리핑 및 Slack 명령 활성화
SLACK_TEAM_BRIEFS_ENABLED=false
# 신규 팀 브리핑 승인 정책. 1인 초안 운영은 draft_advisory로 설정합니다.
HERMES_TEAM_KEYWORD_APPROVAL_MODE=legal_before_draft
# risk_based는 위험 플래그가 있을 때 두 역할을 요구합니다.
# single은 외부 실행을 비활성화한 staging에서만 사용할 수 있습니다.
SLACK_CONTENT_APPROVAL_MODE=risk_based

HERMES_DB_PATH=/var/lib/hermes/hermes.db

# 콘텐츠 워커를 연결할 때 EC2의 경로와 서비스 계정 인증을 확인합니다.
LLM_PROVIDER=codex_cli
CODEX_COMMAND=/usr/local/bin/codex
CODEX_HOME=/var/lib/hermes/codex
CODEX_TIMEOUT_SECONDS=180
CODEX_MAX_CONCURRENCY=1

# 운영 대상 EC2의 첫 검증에는 합성 데이터와 외부 실행 차단을 사용합니다.
APP_ENV=staging
USE_FAKE_DATA=true
EXECUTION_ENABLED=false
EXECUTION_MODE=disabled
EXECUTION_KILL_SWITCH=true
EXECUTION_ALLOWED_TARGETS=
COMPLIANCE_POLICY_VERSION=phase0-implementation-baseline

# CSV 대조가 통과한 뒤 활성화합니다. 인증 파일은 EC2용 WIF 구성입니다.
HERMES_GA4_ENABLED=false
HERMES_GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# GA4와 Google Ads의 실제 CSV 대조 뒤 주간 API 입력을 활성화합니다.
HERMES_GOOGLE_ADS_ENABLED=false
HERMES_GOOGLE_ADS_CUSTOMER_ID=
HERMES_GOOGLE_ADS_CREDENTIALS=/etc/hermes/google-ads-wif.json
