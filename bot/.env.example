# ~/.hermes/.env 또는 bot/.env에 복사해 사용합니다.
# 자격증명은 저장하지 않습니다. `codex login`을 완료하세요.
LLM_PROVIDER=codex_cli
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=180
CODEX_MAX_CONCURRENCY=1

# 생략 시 bot/hermes.db (런타임 파일, Git 제외)
HERMES_DB_PATH=

# Phase 2까지 true 유지
USE_FAKE_DATA=true

# Phase 2 실행 경계: 기본값은 항상 차단
APP_ENV=development
EXECUTION_ENABLED=false
EXECUTION_MODE=disabled
EXECUTION_KILL_SWITCH=true
EXECUTION_ALLOWED_TARGETS=
EXECUTION_MAX_BID_CHANGE_PERCENT=20
EXECUTION_MAX_BUDGET_CHANGE_PERCENT=20
EXECUTION_TRACKING_MAX_AGE_MINUTES=180
EXECUTION_ALLOW_CAMPAIGN_PAUSE=false
COMPLIANCE_POLICY_VERSION=phase0-implementation-baseline
