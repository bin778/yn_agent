# ~/.hermes/.env 에 이 내용을 채워서 저장하세요 (bot/.env.example 자체는 참고용)

DISCORD_BOT_TOKEN=여기에_실제_토큰
GOOGLE_API_KEY=여기에_실제_키
GEMINI_MODEL=gemini-3.5-flash

# DISCORD_SETUP_CHECKLIST.md 진행 후, queues.md에서 확인한 실제 채널ID를 채워넣으세요
DISCORD_CHANNEL_KEYWORD_QUEUE=
DISCORD_CHANNEL_COMPLIANCE_REVIEW=

# true면 GA4/Naver/Ads 대신 fake_data.py 사용 (지금 단계는 true로 유지)
USE_FAKE_DATA=true
